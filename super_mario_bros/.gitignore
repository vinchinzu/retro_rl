# Local save-state captures outside custom integration directories.
/*.state

# Generated optimizer reports/manifests and registry snapshots.
/optimizer/fullgame_manifest*.json
/optimizer/fullgame_eval_report*.json
/optimizer/hybrid_chain_baseline.json
/optimizer/hybrid_report*.json
/optimizer/model_registry.json
/optimizer/model_registry/
/optimizer/smb84_*.json
/optimizer/videos/concat.txt

# Generated map exports from super_mario_editor tooling.
/maps/*.png
/maps/levels_json/*.json

# Never commit ROM/image binaries from this module.
*.png
*.nes
*.sfc
*.smc
*.gba
*.gb
*.gbc
*.zip
