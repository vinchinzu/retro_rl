diff --git i/snes/harvest/harvest/tasks/travel_walk.py w/snes/harvest/harvest/tasks/travel_walk.py
index 35337594..2dfd629e 100644
--- i/snes/harvest/harvest/tasks/travel_walk.py
+++ w/snes/harvest/harvest/tasks/travel_walk.py
@@ -138,3 +138,130 @@ def block_push_facing(
         return False
     temp_blocked.add(facing)
     return True
+
+
+def tile_blocks_charge(
+    pathfinder: Optional[Any],
+    ram: np.ndarray,
+    tx: int,
+    ty: int,
+) -> bool:
+    """True when charging into this tile wastes frames or is blocked.
+
+    Shared by Pathfinder, MultiNav, NavTask, and FarmClearer.
+    Blocked tiles: out of bounds, travel occupied (solids/rocks/stumps),
+    weeds/stones/fences (0x03, 0x04, 0x05), temp_blocked, no_go_tiles,
+    or non-walkable by pathfinder.
+    """
+    if not (0 <= tx < MAP_WIDTH and 0 <= ty < MAP_HEIGHT):
+        return True
+    if is_travel_occupied(ram, tx, ty):
+        return True
+    tid = int(get_tile_at(ram, tx, ty))
+    if tid in TRAVEL_SOLID_TILES:
+        return True
+    if pathfinder is not None:
+        if (tx, ty) in getattr(pathfinder, "temp_blocked", ()):
+            return True
+        if (tx, ty) in getattr(pathfinder, "no_go_tiles", ()):
+            return True
+        if hasattr(pathfinder, "is_walkable") and not pathfinder.is_walkable(ram, tx, ty):
+            return True
+    return False
+
+
+def is_travel_walkable(
+    ram: np.ndarray,
+    tx: int,
+    ty: int,
+    pathfinder: Optional[Any] = None,
+) -> bool:
+    """Unified travel walkability check."""
+    return not tile_blocks_charge(pathfinder, ram, tx, ty)
+
+
+def neighbor_tile(tx: int, ty: int, direction: str) -> Tuple[int, int]:
+    dx, dy = DIR_DELTA.get(direction, (0, 0))
+    return tx + dx, ty + dy
+
+
+def safe_walk_action(
+    pathfinder: Optional[Any],
+    navigator: Any,
+    ram: np.ndarray,
+    preferred: str,
+    *,
+    secondary: Optional[str] = None,
+    allow_detour: bool = False,
+) -> Optional[np.ndarray]:
+    """Hold B+dir only if the next tile is not a solid/bush thrash cell."""
+    from retro_harness.actions import snes_action
+
+    cur = navigator.current_tile
+    order: list[str] = []
+    candidates = (
+        (preferred, secondary, "down", "right", "left", "up")
+        if allow_detour
+        else (preferred, secondary)
+    )
+    for direction in candidates:
+        if direction and direction not in order:
+            order.append(direction)
+    for direction in order:
+        nx, ny = neighbor_tile(cur[0], cur[1], direction)
+        if tile_blocks_charge(pathfinder, ram, nx, ny):
+            continue
+        if hasattr(navigator, "note_push_facing") and navigator.note_push_facing(ram, (nx, ny)):
+            continue
+        return snes_action(dtype=np.int32, **{direction: True, "b": True})
+    return None
+
+
+def check_pixel_stuck_and_replan(
+    navigator: Any,
+    pathfinder: Any,
+    ram: np.ndarray,
+    *,
+    max_stuck_frames: int = PUSH_HOLD_FRAMES,
+) -> Optional[Tuple[int, int]]:
+    """Detect push or pixel-stuck oscillation, mark facing tile in temp_blocked, and replan immediately."""
+    cur_pos = getattr(navigator, "current_pos", None)
+    if cur_pos is None:
+        return None
+    cur_px = (cur_pos.x, cur_pos.y)
+
+    anchor = getattr(navigator, "_pixel_anchor", None)
+    stuck_frames = getattr(navigator, "_pixel_stuck_frames", 0)
+
+    if anchor is not None and max(abs(cur_px[0] - anchor[0]), abs(cur_px[1] - anchor[1])) < 4:
+        stuck_frames += 1
+    else:
+        anchor = cur_px
+        stuck_frames = 0
+    setattr(navigator, "_pixel_anchor", anchor)
+    setattr(navigator, "_pixel_stuck_frames", stuck_frames)
+
+    stasis = getattr(navigator, "stasis", 0)
+    if stuck_frames < max_stuck_frames and stasis < max_stuck_frames:
+        return None
+
+    # Identify blocked tile
+    path = getattr(navigator, "path", [])
+    if path:
+        blocked_tile = path[0]
+    else:
+        current_tile = getattr(navigator, "current_tile", (cur_pos.x // 16, cur_pos.y // 16))
+        blocked_tile = facing_tile(current_tile, read_player_direction(ram))
+
+    if blocked_tile is not None and pathfinder is not None:
+        if hasattr(pathfinder, "temp_blocked"):
+            pathfinder.temp_blocked.add(blocked_tile)
+
+    setattr(navigator, "path", [])
+    setattr(navigator, "stasis", 0)
+    setattr(navigator, "_pixel_stuck_frames", 0)
+    setattr(navigator, "_push_tile", None)
+    setattr(navigator, "_push_px", None)
+    setattr(navigator, "_push_hold", 0)
+    return blocked_tile
+
