# Public-repository safety policy
#
# Keep source, tests, docs, and emulator integration metadata. Keep local ROMs,
# save states, recordings, ROM-derived media/data, trained models, caches, and
# third-party working clones out of Git at every directory depth.

# Python caches, build output, and test/tool state
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
build/
dist/
wheels/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local environment/secrets
**/.venv/
**/venv/
.env
.env.*
!.env.example
!.env.sample
retro_env/
*.pem
*.key
*.p12
credentials*.json
secrets*.json

# OS and editor state
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ROM directories and cartridge/disc images
roms/
**/roms/
*.rom
*.sfc
*.smc
*.swc
*.fig
*.nes
*.fds
*.gba
*.gb
*.gbc
*.gen
*.sms
*.gg
*.n64
*.z64
*.v64
*.iso
*.cue
*.chd
*.wad
*.bin
*.undo

# Emulator saves, save states, and state deltas
**/saves/
*.state
*.state.*
*.sav
*.save
*.srm
*.rtc
*.frm
*.delta

# Recordings, replays, TAS input, and captured media
**/recording/
**/recordings/
**/replays/
**/demos/
**/tas/
*.bk2
*.fm2
*.replay.jsonl
*.jsonl
*.mp4
*.mkv
*.avi
*.webm
*.mov
*.ogv
*.mpeg
*.mpg
*.wav
*.mp3
*.ogg
*.flac
*.aac
*.m4a
*.spc
*.nsf
*.gbs
*.vgm
*.brr

# ROM-derived or otherwise non-redistributable visual/game assets
**/screenshots/
**/state_screenshots/
**/montages/
**/debug_screens/
**/debug_frames/
*.png
*.gif
*.jpg
*.jpeg
*.bmp
*.webp
*.tif
*.tiff
*.ico
*.svg
*.pal
*.chr
*.ttf
*.otf
*.pdf
*.ips
*.bps
*.xdelta

# Trained models, numeric dumps, archives, and generated datasets
**/models/
**/checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.pickle
*.npy
*.npz
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.db
*.sqlite
*.sqlite3

# Logs, training runs, optimizer output, and debugging artifacts
**/logs/
**/wandb/
**/tensorboard/
**/optimizer/runs/
**/debug_*/
*.log
*.monitor.csv
**/events.out.tfevents.*
best_times.json
split_runs.jsonl
**/experiments/results.*

# Stale experiments and session-specific material
**/archive/
# Keep curated research docs under snes_oneshot/docs/archive/.
!snes_oneshot/docs/archive/
!snes_oneshot/docs/archive/**
onotes.md
TRAINING_IN_PROGRESS.md
monitor_all_training.sh
*.bak
**/.*_last_*
donkey_kong_country/button
donkey_kong_country/notes
harvest/tasks/

# Recorded input policies and ROM-derived navigation/map exports
super_metroid/policies/*
!super_metroid/policies/room_clears/
!super_metroid/policies/room_clears/*.json
super_metroid/custom_integrations/*/*.provenance.json
super_metroid/maps/*
!super_metroid/maps/README.md

# Agent/session configuration and local task databases
.claude/
**/CLAUDE.md
**/.agents.md
**/.beads/
**/.bv/

# Third-party/reference source trees are cloned separately.
harvest/HM-Decomp/
uwnh/
super_metroid_rl/
SMW/refs/*
!SMW/refs/README.md
SMW/tools/external/*
!SMW/tools/external/README.md

# Other generated build/runtime trees
**/.gradle/
**/boss_data/

# SMB's compact JSON controller policies and aggregate completion evidence are
# source artifacts, not trained model/checkpoint or raw recording dumps.
!smb/models/
smb/models/*
!smb/models/smb_1_1_clear.json
!smb/models/smb_1_2_warp_w4.json
!smb/models/smb_warp_mid_to_ending.json
!smb/models/smb_1_1_to_ending.json
!smb/recordings/
smb/recordings/*
!smb/recordings/warp_finish/
smb/recordings/warp_finish/*
!smb/recordings/warp_finish/warp_finish_chain_trials_report.json
!smb/recordings/warp_finish/warp_finish_suffix_trials_report.json
!smb/recordings/warp_finish/warp_finish_continuous_trials_report.json
!smb/recordings/warp_finish/warp_finish_poweron_trials_report.json
!smb/recordings/warp_finish/warp_finish_poweron_m8_capture.json
