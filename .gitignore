# Public-repository safety policy
#
# Keep source, tests, docs, and emulator integration metadata. Keep local ROMs,
# save states, recordings, ROM-derived media/data, trained models, caches, and
# third-party working clones out of Git at every directory depth.

# Python caches, build output, and test/tool state
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
build/
dist/
wheels/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local environment/secrets
**/.venv/
**/venv/
.env
.env.*
!.env.example
!.env.sample
retro_env/
*.pem
*.key
*.p12
credentials*.json
secrets*.json

# OS and editor state
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ROM directories and cartridge/disc images
roms/
**/roms/
*.rom
*.sfc
*.smc
*.swc
*.fig
*.nes
*.fds
*.gba
*.gb
*.gbc
*.gen
*.sms
*.gg
*.n64
*.z64
*.v64
*.iso
*.cue
*.chd
*.wad
*.bin
*.undo

# Emulator saves, save states, and state deltas
**/saves/
*.state
*.state.*
*.sav
*.save
*.srm
*.rtc
*.frm
*.delta

# Recordings, replays, TAS input, and captured media
**/recording/
**/recordings/
**/replays/
**/demos/
**/tas/
# SMB TAS adapt toolkit (Python package under nes/smb/tas/; keep *.fm2 ignored)
!nes/smb/tas/
!nes/smb/tas/**/*.py
!nes/smb/tas/**/__init__.py
# Super Metroid TAS import (Sniq any%/100%); keep movies/slices ignored (re-fetch)
!snes/super_metroid/tas/
!snes/super_metroid/tas/**/*.py
!snes/super_metroid/tas/**/__init__.py
!snes/super_metroid/tas/README.md
# Zelda I TAS import (Lord Tom any% / chatterbox all-items); keep *.fm2 ignored
!nes/zelda_i/tas/
!nes/zelda_i/tas/**/*.py
!nes/zelda_i/tas/**/__init__.py
!nes/zelda_i/tas/README.md
*.bk2
*.fm2
*.lsmv
*.replay.jsonl
*.jsonl
# Beads exports must be trackable (override blanket *.jsonl)
!.beads/
!.beads/*.jsonl
!.beads/config.yaml
!.beads/metadata.json
!.beads/README.md
*.mp4
*.mkv
*.avi
*.webm
*.mov
*.ogv
*.mpeg
*.mpg
*.wav
*.mp3
*.ogg
*.flac
*.aac
*.m4a
*.spc
*.nsf
*.gbs
*.vgm
*.brr

